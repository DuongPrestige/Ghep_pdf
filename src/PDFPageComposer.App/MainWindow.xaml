<Window x:Class="PDFPageComposer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:PDFPageComposer.App.Behaviors"
        xmlns:converters="clr-namespace:PDFPageComposer.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:models="clr-namespace:PDFPageComposer.App.Models"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDF Page Composer"
        MinWidth="1024"
        MinHeight="640"
        Width="1366"
        Height="768"
        FontSize="14"
        WindowState="Maximized"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <converters:ThumbnailImageConverter x:Key="ThumbnailImageConverter" />
        <converters:BgraImageConverter x:Key="BgraImageConverter" />
        <converters:RenderedPageImageConverter x:Key="RenderedPageImageConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="28" />
        </Style>
        <Style x:Key="NumberBadge" TargetType="Border">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>
    <Grid PreviewMouseWheel="OnPreviewMouseWheel">
    <DockPanel Background="#F6F7F9">
        <ToolBar DockPanel.Dock="Top"
                 Padding="8,6"
                 Background="#FFFFFF">
            <Button Command="{Binding AddPdfCommand}"
                    Content="Thêm PDF"
                    Padding="12,6"
                    Margin="0,0,8,0" />
            <Button Content="Xóa file"
                    Padding="12,6"
                    Margin="0,0,8,0" />
            <Separator />
            <Button Content="Chọn tất cả"
                    Padding="12,6"
                    Margin="8,0"
                    Command="{Binding SelectAllPagesCommand}" />
            <Button Content="Bỏ chọn"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Command="{Binding ClearAllSelectionCommand}" />
            <StackPanel Margin="0,0,8,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedPageSummary}"
                           FontSize="11"
                           Foreground="#475569"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2" />
                <Button Command="{Binding AddSelectionToOutputCommand}"
                        Content="Thêm vào đầu ra"
                        ToolTip="Thêm các trang đang chọn vào khay đầu ra (phím Enter)"
                        Padding="12,6" />
            </StackPanel>
            <Separator />
            <TextBlock Text="Zoom"
                       VerticalAlignment="Center"
                       Margin="8,0,6,0" />
            <Slider Value="{Binding ThumbnailZoom}"
                    Minimum="0.6"
                    Maximum="1.6"
                    Width="120"
                    VerticalAlignment="Center" />
            <Separator />
            <Button Command="{Binding UndoCommand}"
                    Content="Hoàn tác"
                    Padding="12,6"
                    Margin="8,0" />
            <Button Command="{Binding RedoCommand}"
                    Content="Làm lại"
                    Padding="12,6"
                    Margin="0,0,8,0" />
            <Button Command="{Binding PreviewOutputCommand}"
                    Content="Xem trước đầu ra"
                    Padding="14,6"
                    Margin="0,0,8,0" />
            <Button Command="{Binding ExportPdfCommand}"
                    Content="Xuất PDF"
                    Padding="14,6"
                    Margin="0,0,8,0" />
            <Button Command="{Binding CheckForUpdateCommand}"
                    Content="Check update"
                    Padding="14,6"
                    Margin="0,0,8,0" />
            <Separator />
            <Button Content="Đơn TikTok"
                    Padding="14,6"
                    Margin="8,0,0,0"
                    Click="OnOpenTikTokOrdersClick" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom"
                   Background="#FFFFFF">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="File: " />
                    <Run Text="{Binding SourceFileCount, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Trang nguồn: " />
                    <Run Text="{Binding SourcePageCount, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Đang chọn: " />
                    <Run Text="{Binding SelectedPageCount, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Đầu ra: " />
                    <Run Text="{Binding OutputPageCount, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding RenderStatus}" />
            </StatusBarItem>
            <Separator Visibility="{Binding HasRecoverySession, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StatusBarItem Visibility="{Binding HasRecoverySession, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RecoveryStatus}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Button Content="Phục hồi"
                            Padding="8,2"
                            Margin="0,0,4,0"
                            Command="{Binding RecoverSessionCommand}" />
                    <Button Content="Bỏ qua"
                            Padding="8,2"
                            Command="{Binding DismissRecoveryCommand}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right"
                           HorizontalContentAlignment="Right">
                <TextBlock Text="{Binding AppVersionText}"
                           Foreground="#64748B"
                           FontWeight="SemiBold"
                           Margin="12,0,8,0" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    Background="#F6F7F9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tất cả file và trang"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Tìm tên"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Foreground="#475569" />
                            <TextBox Width="220"
                                     Height="26"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SourceSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Xóa"
                                    Padding="10,3"
                                    Margin="6,0,0,0"
                                    Command="{Binding ClearSourceSearchCommand}" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="SourceFileList"
                             Grid.Row="1"
                             ItemsSource="{Binding FilteredSourceFiles}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseWheel="OnSourceFileListMouseWheel"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF"
                                        BorderBrush="#D9DEE8"
                                        BorderThickness="1"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="Thu gọn"
                                                        Style="{StaticResource RowButton}"
                                                        ToolTip="Ẩn / hiện các trang của file"
                                                        Command="{Binding DataContext.ToggleSourceFileCollapseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Chọn tất cả"
                                                        Style="{StaticResource RowButton}"
                                                        Command="{Binding DataContext.SelectAllInFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Bỏ chọn"
                                                        Style="{StaticResource RowButton}"
                                                        Command="{Binding DataContext.ClearSelectionInFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Chọn lại"
                                                        Style="{StaticResource RowButton}"
                                                        ToolTip="Chọn lại file khi file đã bị di chuyển"
                                                        Command="{Binding DataContext.RelinkSourceFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Xóa"
                                                        Style="{StaticResource RowButton}"
                                                        Foreground="#B91C1C"
                                                        Command="{Binding DataContext.RemoveSourceFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="   " />
                                                <Run Text="{Binding PageCount, Mode=OneWay}" Foreground="#64748B" />
                                                <Run Text=" trang" Foreground="#64748B" />
                                            </TextBlock>
                                        </DockPanel>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      PreviewMouseWheel="OnPageStripMouseWheel">
                                            <ScrollViewer.Style>
                                                <Style TargetType="ScrollViewer">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>
                                            <ItemsControl ItemsSource="{Binding Pages}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{Binding DataContext.ThumbnailCardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Margin="0,0,8,4"
                                                                BorderThickness="2"
                                                                Cursor="Hand"
                                                                ToolTip="Bấm để chọn / bỏ chọn (Ctrl, Shift để chọn nhiều) · nháy đúp để xem lớn"
                                                                MouseLeftButtonUp="OnThumbnailClick"
                                                                MouseLeftButtonDown="OnThumbnailMouseLeftButtonDown"
                                                                behaviors:LoadedCommandBehavior.Command="{Binding DataContext.RenderThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                behaviors:LoadedCommandBehavior.CommandParameter="{Binding}"
                                                                behaviors:LoadedCommandBehavior.UnloadedCommand="{Binding DataContext.CancelThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                                    <Setter Property="Background" Value="#F8FAFD" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#2563EB" />
                                                                            <Setter Property="Background" Value="#DBEAFE" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <Grid Height="{Binding DataContext.ThumbnailPreviewHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="4">
                                                                    <Image Stretch="Uniform">
                                                                        <Image.Source>
                                                                            <MultiBinding Converter="{StaticResource BgraImageConverter}">
                                                                                <Binding Path="ThumbnailPixels" />
                                                                                <Binding Path="ThumbnailPixelWidth" />
                                                                                <Binding Path="ThumbnailPixelHeight" />
                                                                                <Binding Path="ThumbnailStride" />
                                                                            </MultiBinding>
                                                                        </Image.Source>
                                                                    </Image>
                                                                    <TextBlock Text="Đang tải…"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="#657084"
                                                                               FontSize="12">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ThumbnailState}" Value="{x:Static models:ThumbnailState.Loading}">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ThumbnailState}" Value="{x:Static models:ThumbnailState.Error}">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <TextBlock Text="Lỗi hiển thị" Foreground="#B91C1C" FontSize="12" HorizontalAlignment="Center" />
                                                                        <Button Content="Thử lại"
                                                                                Padding="8,1"
                                                                                Margin="0,6,0,0"
                                                                                Command="{Binding DataContext.RetryThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                    <!-- How many times the page is already in the output tray. -->
                                                                    <Border Style="{StaticResource NumberBadge}"
                                                                            ToolTip="Số lần trang này có trong khay đầu ra">
                                                                        <Border.Visibility>
                                                                            <Binding Path="OutputOccurrenceCount">
                                                                                <Binding.Converter>
                                                                                    <converters:NonZeroToVisibilityConverter />
                                                                                </Binding.Converter>
                                                                            </Binding>
                                                                        </Border.Visibility>
                                                                        <TextBlock Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Run Text="x" /><Run Text="{Binding OutputOccurrenceCount, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </Border>
                                                                    <Border HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top"
                                                                            Margin="4"
                                                                            Width="22"
                                                                            Height="22"
                                                                            Background="#2563EB"
                                                                            CornerRadius="11"
                                                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="✓" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </Grid>
                                                                <DockPanel Margin="6,0,4,4">
                                                                    <Button DockPanel.Dock="Right"
                                                                            Content="Xem"
                                                                            FontSize="12"
                                                                            Padding="6,0"
                                                                            Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                    <TextBlock FontSize="12" VerticalAlignment="Center">
                                                                        <Run Text="Trang " /><Run Text="{Binding PageNumber, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="#CCD3DF" />

            <Border Grid.Column="2"
                    Padding="16"
                    Background="#EEF1F5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#475569">
                            <Run Text="{Binding OutputPageCount, Mode=OneWay}" /><Run Text=" trang" />
                        </TextBlock>
                        <TextBlock Text="Khay đầu ra" FontSize="18" FontWeight="SemiBold" />
                    </DockPanel>
                    <ListBox x:Name="OutputTrayList"
                             Grid.Row="1"
                             ItemsSource="{Binding OutputTrayItems}"
                             SelectionMode="Extended"
                             Background="#E2E8F0"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Margin" Value="3" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="172"
                                        Background="#FFFFFF"
                                        BorderBrush="#94A3B8"
                                        BorderThickness="1"
                                        AllowDrop="True"
                                        ToolTip="Kéo thả để đổi vị trí (thả nửa trái = đứng trước, nửa phải = đứng sau) · Ctrl/Shift để chọn nhiều"
                                        PreviewMouseMove="OnOutputItemPreviewMouseMove"
                                        DragOver="OnOutputItemDragOver"
                                        Drop="OnOutputItemDrop">
                                    <StackPanel>
                                        <Border Height="5" Background="{Binding GroupColorHex}" />
                                        <Grid Height="225"
                                              Margin="4"
                                              behaviors:LoadedCommandBehavior.Command="{Binding DataContext.RenderThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              behaviors:LoadedCommandBehavior.CommandParameter="{Binding SourcePage}">
                                            <Image Stretch="Uniform">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource BgraImageConverter}">
                                                        <Binding Path="SourcePage.ThumbnailPixels" />
                                                        <Binding Path="SourcePage.ThumbnailPixelWidth" />
                                                        <Binding Path="SourcePage.ThumbnailPixelHeight" />
                                                        <Binding Path="SourcePage.ThumbnailStride" />
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                            <Border Style="{StaticResource NumberBadge}" ToolTip="Thứ tự trong file xuất">
                                                <TextBlock Text="{Binding OutputIndex}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="4,0">
                                            <Run Text="{Binding SourceDisplayName, Mode=OneWay}" />
                                            <Run Text=" · tr " /><Run Text="{Binding SourcePageNumber, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding GroupName}"
                                                   Foreground="{Binding GroupColorHex}"
                                                   FontSize="12"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="4,0"
                                                   ToolTip="Kéo tên nhóm để chuyển cả nhóm"
                                                   AllowDrop="True"
                                                   PreviewMouseMove="OnOutputGroupPreviewMouseMove"
                                                   DragOver="OnOutputGroupDragOver"
                                                   Drop="OnOutputGroupDrop" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,2">
                                            <Button Content="◀" Style="{StaticResource IconButton}" ToolTip="Đưa lên trước"
                                                    Command="{Binding DataContext.MoveOutputItemUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="▶" Style="{StaticResource IconButton}" ToolTip="Đưa ra sau"
                                                    Command="{Binding DataContext.MoveOutputItemDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="+" Style="{StaticResource IconButton}" ToolTip="Nhân bản trang này"
                                                    Command="{Binding DataContext.DuplicateOutputItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="✕" Style="{StaticResource IconButton}" ToolTip="Bỏ trang này" Foreground="#B91C1C"
                                                    Command="{Binding DataContext.DeleteOutputItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,6">
                                            <Button Content="Xem" FontSize="12" Padding="8,0" Margin="2,0"
                                                    Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding SourcePage}" />
                                            <Button Content="Nhân nhóm" FontSize="12" Padding="8,0" Margin="2,0"
                                                    ToolTip="Nhân bản cả nhóm trang này"
                                                    Command="{Binding DataContext.DuplicateOutputGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Group}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <Button Content="Nhân bản"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="OnDuplicateSelectedOutputItems" />
                        <Button Content="Xóa"
                                Padding="12,6"
                                Click="OnDeleteSelectedOutputItems" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
    <Border Background="#B3000000"
            Visibility="{Binding IsPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid Margin="48"
              Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="16,12">
                <Button DockPanel.Dock="Right"
                        Content="Đóng  ✕"
                        Padding="14,5"
                        Margin="12,0,0,0"
                        ToolTip="Đóng xem trước (Esc)"
                        Command="{Binding ClosePreviewCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="10,4" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                            <Setter Property="MinWidth" Value="32" />
                        </Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="1" />
                            <Setter Property="Background" Value="#CBD5E1" />
                            <Setter Property="Margin" Value="8,2" />
                        </Style>
                    </StackPanel.Resources>
                    <Button Content="◀ Trước" IsEnabled="{Binding CanNavigatePreviewPrevious}" Command="{Binding PreviewPreviousCommand}" />
                    <Button Content="Sau ▶" IsEnabled="{Binding CanNavigatePreviewNext}" Command="{Binding PreviewNextCommand}" />
                    <Border />
                    <Button Content="Lưới tất cả trang" ToolTip="Xem mọi trang dạng lưới" Command="{Binding ShowPreviewGridCommand}" />
                    <Button Content="Xem 1 trang" ToolTip="Xem lớn trang đang chọn" Command="{Binding ShowSinglePreviewCommand}" />
                    <Border />
                    <Button Content="Vừa trang" Command="{Binding SetPreviewFitModeCommand}" CommandParameter="{x:Static models:PreviewFitMode.FitPage}" />
                    <Button Content="Vừa rộng" Command="{Binding SetPreviewFitModeCommand}" CommandParameter="{x:Static models:PreviewFitMode.FitWidth}" />
                    <Button Content="Vừa cao" Command="{Binding SetPreviewFitModeCommand}" CommandParameter="{x:Static models:PreviewFitMode.FitHeight}" />
                    <Button Content="−" ToolTip="Thu nhỏ" Command="{Binding PreviewZoomOutCommand}" />
                    <Button Content="+" ToolTip="Phóng to" Command="{Binding PreviewZoomInCommand}" />
                    <Border />
                    <Button Content="Chọn / bỏ chọn trang" Command="{Binding TogglePreviewSelectionCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Padding" Value="10,4" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutputPreviewMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsOutputPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="Nhân bản" ToolTip="Thêm bản sao trang đang chọn" Command="{Binding DuplicateCurrentOutputPreviewItemCommand}" />
                        <Button Content="◀ Lên" ToolTip="Đưa trang đang chọn lên trước" Command="{Binding MoveCurrentOutputPreviewItemUpCommand}" />
                        <Button Content="Xuống ▶" ToolTip="Đưa trang đang chọn ra sau" Command="{Binding MoveCurrentOutputPreviewItemDownCommand}" />
                        <Button Content="Xóa" Foreground="#B91C1C" ToolTip="Bỏ trang đang chọn khỏi đầu ra" Command="{Binding DeleteCurrentOutputPreviewItemCommand}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding PreviewTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Border Grid.Row="1"
                    Margin="16,0,16,16"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <Grid>
                    <!-- "Lưới tất cả trang" of one source file. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPreviewGridOpen}" Value="True" />
                                            <Condition Binding="{Binding IsOutputPreviewMode}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding PreviewGridPages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200"
                                            Margin="6"
                                            BorderThickness="2"
                                            Cursor="Hand"
                                            ToolTip="Bấm để chọn / bỏ chọn · nháy đúp để xem lớn"
                                            MouseLeftButtonUp="OnThumbnailClick"
                                            MouseLeftButtonDown="OnThumbnailMouseLeftButtonDown"
                                            behaviors:LoadedCommandBehavior.Command="{Binding DataContext.RenderThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            behaviors:LoadedCommandBehavior.CommandParameter="{Binding}"
                                            behaviors:LoadedCommandBehavior.UnloadedCommand="{Binding DataContext.CancelThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                <Setter Property="Background" Value="#FFFFFF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                                        <Setter Property="Background" Value="#DBEAFE" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid Height="270" Margin="6">
                                                <Image Stretch="Uniform">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource BgraImageConverter}">
                                                            <Binding Path="ThumbnailPixels" />
                                                            <Binding Path="ThumbnailPixelWidth" />
                                                            <Binding Path="ThumbnailPixelHeight" />
                                                            <Binding Path="ThumbnailStride" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                                <Border Style="{StaticResource NumberBadge}"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="✓" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <DockPanel Margin="8,0,6,6">
                                                <Button DockPanel.Dock="Right"
                                                        Content="Xem"
                                                        FontSize="12"
                                                        Padding="6,0"
                                                        Command="{Binding DataContext.OpenPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock FontSize="13" VerticalAlignment="Center">
                                                    <Run Text="Trang " /><Run Text="{Binding PageNumber, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- "Lưới tất cả trang" of the output: every page in export order. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPreviewGridOpen}" Value="True" />
                                            <Condition Binding="{Binding IsOutputPreviewMode}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding AllOutputPreviewGridItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200"
                                            Margin="6"
                                            Background="#FFFFFF"
                                            Cursor="Hand"
                                            AllowDrop="True"
                                            PreviewMouseMove="OnOutputItemPreviewMouseMove"
                                            DragOver="OnOutputItemDragOver"
                                            Drop="OnOutputItemDrop"
                                            ToolTip="Bấm để chọn · kéo thả để đổi vị trí (thả nửa trái = đứng trước, nửa phải = đứng sau) · nháy đúp để xem lớn"
                                            behaviors:LoadedCommandBehavior.Command="{Binding DataContext.RenderThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            behaviors:LoadedCommandBehavior.CommandParameter="{Binding SourcePage}"
                                            behaviors:LoadedCommandBehavior.UnloadedCommand="{Binding DataContext.CancelThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.SelectOutputPreviewItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenOutputPreviewItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPreviewSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                                        <Setter Property="BorderThickness" Value="3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Border Height="5" Background="{Binding GroupColorHex}" />
                                            <Grid Height="270" Margin="6">
                                                <Image Stretch="Uniform">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource BgraImageConverter}">
                                                            <Binding Path="SourcePage.ThumbnailPixels" />
                                                            <Binding Path="SourcePage.ThumbnailPixelWidth" />
                                                            <Binding Path="SourcePage.ThumbnailPixelHeight" />
                                                            <Binding Path="SourcePage.ThumbnailStride" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                                <Border Style="{StaticResource NumberBadge}" ToolTip="Thứ tự trong file xuất">
                                                    <TextBlock Text="{Binding OutputIndex}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="6,0">
                                                <Run Text="{Binding SourceDisplayName, Mode=OneWay}" />
                                                <Run Text=" · tr " /><Run Text="{Binding SourcePageNumber, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding GroupName}"
                                                       Foreground="{Binding GroupColorHex}"
                                                       FontSize="12"
                                                       TextAlignment="Center"
                                                       Margin="6,0,6,6" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Image Source="{Binding PreviewImage, Converter={StaticResource RenderedPageImageConverter}}"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Margin="16">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewFitMode}" Value="{x:Static models:PreviewFitMode.FitPage}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPreviewGridOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewFitMode}" Value="{x:Static models:PreviewFitMode.FitPage}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPreviewGridOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <Image Source="{Binding PreviewImage, Converter={StaticResource RenderedPageImageConverter}}"
                               Stretch="None"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="16" />
                    </ScrollViewer>
                    <TextBlock Text="Đang render preview"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#475569">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewState}" Value="{x:Static models:ThumbnailState.Loading}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding PreviewError}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#B42318">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewState}" Value="{x:Static models:ThumbnailState.Error}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
    <Border Background="#99000000"
            Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Width="360"
                Padding="20"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Đang xuất PDF"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Height="18"
                             Value="{Binding ExportProgressPercent}" />
                <TextBlock Text="{Binding ExportProgressText}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Foreground="#475569" />
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>
