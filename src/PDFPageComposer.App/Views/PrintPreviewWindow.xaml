<Window x:Class="PDFPageComposer.App.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:PDFPageComposer.App.Behaviors"
        xmlns:conv="clr-namespace:PDFPageComposer.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PDFPageComposer.App.ViewModels.TikTok"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PrintPreviewViewModel}"
        Title="Xem trước file in"
        Icon="pack://application:,,,/PDFPageComposer.App;component/Assets/app.ico"
        Width="1400"
        Height="860"
        MinWidth="900"
        MinHeight="560"
        FontSize="14"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7F9">
    <Window.Resources>
        <conv:BgraImageConverter x:Key="BgraImageConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="OptionalText" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Copy mã tất cả đơn"
                        Padding="10,2"
                        ToolTip="Copy mã mọi đơn trong file in, mỗi mã một dòng, theo thứ tự in"
                        Visibility="{Binding CanCopy, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding CopyAllOrderIdsCommand}" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding CopyStatus}"
                           Foreground="#15803D"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Text="Thứ tự giống file in. Bấm &quot;Đổi file&quot; để chọn lại trang cho đơn, &quot;Bỏ khỏi lô&quot; để không in đơn này lần này."
                       Foreground="#64748B"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding RejectedText}" Style="{StaticResource OptionalText}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đóng" Padding="18,6" Margin="0,0,8,0" IsCancel="True" Command="{Binding CloseCommand}" />
                <Button Content="Tạo file in"
                        Padding="18,6"
                        FontWeight="SemiBold"
                        IsEnabled="{Binding HasOrders}"
                        Command="{Binding CreatePrintFileCommand}" />
            </StackPanel>
        </DockPanel>

        <ListBox ItemsSource="{Binding Orders}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Standard"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFFFFF" BorderBrush="#D9DEE8" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Đổi file"
                                            Padding="10,2"
                                            ToolTip="Xem và chọn lại các trang in cho đơn này"
                                            Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Bỏ khỏi lô"
                                            Padding="10,2"
                                            Margin="6,0,0,0"
                                            Foreground="#B91C1C"
                                            ToolTip="Bỏ tick đơn này, không in trong lô này"
                                            Command="{Binding DataContext.RemoveOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Left"
                                        Content="Copy"
                                        FontSize="12"
                                        Padding="6,0"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Copy mã đơn"
                                        Visibility="{Binding DataContext.CanCopy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Command="{Binding DataContext.CopyOrderIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding OrderId, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="   " />
                                    <Run Text="{Binding ItemsText, Mode=OneWay}" />
                                    <Run Text="   " />
                                    <Run Text="{Binding SheetText, Mode=OneWay}" Foreground="#64748B" />
                                </TextBlock>
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{Binding ProductsText}"
                                       Foreground="#475569"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Có file chọn tay"
                                       Foreground="#1D4ED8"
                                       FontSize="12"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding HasManualChoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding Pages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="150" Margin="0,0,8,6" Background="#F8FAFD" BorderBrush="#CBD5E1" BorderThickness="1">
                                            <StackPanel>
                                                <Grid Height="205"
                                                      Margin="4"
                                                      Background="#FFFFFF"
                                                      behaviors:LoadedCommandBehavior.Command="{Binding DataContext.RenderPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      behaviors:LoadedCommandBehavior.CommandParameter="{Binding}">
                                                    <Image Stretch="Uniform">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource BgraImageConverter}">
                                                                <Binding Path="Pixels" />
                                                                <Binding Path="PixelWidth" />
                                                                <Binding Path="PixelHeight" />
                                                                <Binding Path="Stride" />
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                    <TextBlock Text="Trang trắng"
                                                               Foreground="#94A3B8"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsBlank, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="Không mở được file"
                                                               Foreground="#B91C1C"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Border Background="#2563EB"
                                                            CornerRadius="11"
                                                            MinWidth="22"
                                                            Height="22"
                                                            Padding="5,0"
                                                            Margin="4"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            ToolTip="Số trang trong file in">
                                                        <TextBlock Text="{Binding OutputNumber}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Caption}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="4,0,4,4" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
