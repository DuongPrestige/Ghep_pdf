<Window x:Class="PDFPageComposer.App.Views.OrderFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:PDFPageComposer.App.Behaviors"
        xmlns:conv="clr-namespace:PDFPageComposer.App.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PDFPageComposer.App.ViewModels.TikTok"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OrderFilesViewModel}"
        Title="{Binding Title}"
        Width="1400"
        Height="860"
        MinWidth="1000"
        MinHeight="600"
        FontSize="14"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#F6F7F9">
    <Window.Resources>
        <conv:BgraImageConverter x:Key="BgraImageConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Page image of a thumbnail (rendered lazily when the element loads), with an error text when it fails. -->
        <DataTemplate x:Key="PageImage" DataType="{x:Type vm:PageThumbViewModel}">
            <Grid behaviors:LoadedCommandBehavior.Command="{Binding DataContext.RenderThumbnailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  behaviors:LoadedCommandBehavior.CommandParameter="{Binding}">
                <Image Stretch="Uniform">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource BgraImageConverter}">
                            <Binding Path="Pixels" />
                            <Binding Path="PixelWidth" />
                            <Binding Path="PixelHeight" />
                            <Binding Path="Stride" />
                        </MultiBinding>
                    </Image.Source>
                </Image>
                <TextBlock Text="Không mở được file"
                           Foreground="#B91C1C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PositionBadge" TargetType="Border">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="28" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Header: order, sets of the order (when more than one) and the selected set's status. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding Slots}"
                     SelectedItem="{Binding SelectedSlot}"
                     Margin="0,6,0,0"
                     BorderThickness="0"
                     Background="Transparent"
                     Visibility="{Binding HasManySlots, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Padding="6,2">
                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" · " />
                            <Run Text="{Binding StatusText, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding MissingFilesText}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left"
                    Content="Dùng lại chọn tự động"
                    Padding="12,6"
                    ToolTip="Bỏ các trang đã chọn tay, quay về chọn file mới nhất tự động"
                    Command="{Binding UseAutomaticCommand}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Hủy" Padding="18,6" Margin="0,0,8,0" IsCancel="True" Command="{Binding CancelCommand}" />
                <Button Content="Lưu lựa chọn"
                        Padding="18,6"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        IsEnabled="{Binding CanSave}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding ValidationText}" Foreground="#B91C1C" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: every library file as a row of pages; click a page to add/remove it. -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Kho file · bấm vào trang để chọn / bỏ chọn"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Padding="4,2"
                             ToolTip="Lọc theo tên file (mặc định là idol của bộ đang chọn)" />
                </DockPanel>
                <ListBox x:Name="LibraryList"
                         ItemsSource="{Binding LibraryFiles}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Standard"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" BorderBrush="#D9DEE8" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right"
                                                Content="Lấy cả file"
                                                Padding="10,2"
                                                ToolTip="Thêm mọi trang chưa chọn của file này vào bộ đang chọn"
                                                Command="{Binding DataContext.AddWholeFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="   " />
                                            <Run Text="{Binding InfoText, Mode=OneWay}" Foreground="#64748B" />
                                        </TextBlock>
                                    </DockPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="OnPageStripMouseWheel">
                                        <ItemsControl ItemsSource="{Binding Pages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="132"
                                                            Margin="0,0,8,4"
                                                            Background="#F8FAFD"
                                                            BorderThickness="2"
                                                            Cursor="Hand"
                                                            ToolTip="Bấm để chọn / bỏ chọn trang này"
                                                            MouseLeftButtonUp="OnLibraryPageClick">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                                                        <Setter Property="Background" Value="#DBEAFE" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Grid Height="180" Margin="4">
                                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageImage}" />
                                                                <Border Style="{StaticResource PositionBadge}"
                                                                        Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding Position}" Foreground="White" FontSize="12" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding PageLabel}" FontSize="12" TextAlignment="Center" Margin="0,0,0,3" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: pages chosen for the selected set, in print order. -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right"
                            Content="Bỏ hết"
                            Padding="10,2"
                            Command="{Binding ClearSelectedSlotCommand}" />
                    <TextBlock Text="{Binding SelectedSlotStatus}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="#E2E8F0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedPages}" Margin="6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="172" Margin="6" Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Height="235" Margin="4">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageImage}" />
                                                <Border Style="{StaticResource PositionBadge}">
                                                    <TextBlock Text="{Binding Position}" Foreground="White" FontSize="12" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Caption}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="4,0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6">
                                                <Button Content="◀" Style="{StaticResource IconButton}" ToolTip="Đưa lên trước"
                                                        Command="{Binding DataContext.MovePageLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="▶" Style="{StaticResource IconButton}" ToolTip="Đưa ra sau"
                                                        Command="{Binding DataContext.MovePageRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="✕" Style="{StaticResource IconButton}" ToolTip="Bỏ trang này" Foreground="#B91C1C"
                                                        Command="{Binding DataContext.RemovePageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
